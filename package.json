{
  "name": "quick-sfc",
  "version": "2.0.0-alpha.0",
  "description": "qSFC: a drafting language for Sequential Function Charts, with L5X export",
  "type": "module",
  "private": true,
  "bin": {
    "qsfc": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qsfc": "tsx src/cli/main.ts",
    "build:app": "tsx scripts/build-app.ts",
    "build:app:dev": "tsx scripts/build-app.ts --dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  }
}
