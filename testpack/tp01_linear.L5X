<Routines>
<Routine Name="tp01_linear" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="true" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// idle - Waiting for start]]>
</Line>
<Line Number="1">
<![CDATA[motor := 0;]]>
</Line>
<Line Number="2">
<![CDATA[count := 0;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_001" HideDesc="true" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_001" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// run - Motor runs 3 s]]>
</Line>
<Line Number="1">
<![CDATA[motor [:=] 1;]]>
</Line>
<Line Number="2">
<![CDATA[IF count < 100 THEN]]>
</Line>
<Line Number="3">
<![CDATA[  count := count + 1;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="4" X="200" Y="220" Operand="Tran_000" HideDesc="true" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="5" X="200" Y="505" Operand="Tran_001" HideDesc="true" DescX="260" DescY="485" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="4" Show="true"/>
<DirectedLink FromID="2" ToID="5" Show="true"/>
<DirectedLink FromID="4" ToID="2" Show="true"/>
<DirectedLink FromID="5" ToID="0" Show="true"/>
</SFCContent>
</Routine>
</Routines>
