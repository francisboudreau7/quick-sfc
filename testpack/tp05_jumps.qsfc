// step reached by two jumps (automatic selection convergence).
sfc tp05_jumps

init idle
-- start_btn
step work
  motor [:=] 1;
select
  -- fault -> error
|
  -- done_sig
end
step unload 1s
  pusher [:=] 1;
-- unload.DN -> idle
step error "Fault handling"
  alarm [:=] 1;
-- reset_btn -> idle
