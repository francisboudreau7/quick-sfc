<Routines>
<Routine Name="tp06_tags" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="true" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// idle]]>
</Line>
<Line Number="1">
<![CDATA[speed := 0.0;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_001" HideDesc="true" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_001" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// ramp - Ramp up]]>
</Line>
<Line Number="1">
<![CDATA[speed := speed + 0.5;]]>
</Line>
<Line Number="2">
<![CDATA[IF Step_001.FS THEN]]>
</Line>
<Line Number="3">
<![CDATA[  batch := batch + 1;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="200" Y="645" Operand="Step_002" HideDesc="true" DescX="240" DescY="625" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_002" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// hold]]>
</Line>
<Line Number="1">
<![CDATA[lamp [:=] 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="6" X="200" Y="220" Operand="Tran_000" HideDesc="true" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn AND batch < 10]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="7" X="200" Y="505" Operand="Tran_001" HideDesc="true" DescX="260" DescY="485" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN AND speed >= 10.0]]>
</Line>
<Line Number="1">
<![CDATA[OR tmr.DN]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="6" Show="true"/>
<DirectedLink FromID="2" ToID="7" Show="true"/>
<DirectedLink FromID="6" ToID="2" Show="true"/>
<DirectedLink FromID="7" ToID="4" Show="true"/>
</SFCContent>
</Routine>
</Routines>
</Program>
</Programs>
