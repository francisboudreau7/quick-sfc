<Routines>
<Routine Name="main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// main routine: Studio runs it every scan]]>
</Line>
<Line Number="1">
<![CDATA[JSR(fill_seq,0);]]>
</Line>
<Line Number="2">
<![CDATA[JSR(mixer, 0);]]>
</Line>
<Line Number="3">
<![CDATA[JSR(alarms,0);]]>
</Line>
<Line Number="4">
<![CDATA[busy_lamp := Step_001.X OR Step_004.X;]]>
</Line>
</STContent>
</Routine>
<Routine Name="fill_seq" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="false" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// idle]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_001" HideDesc="false" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_001" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// fill - Fill the tank]]>
</Line>
<Line Number="1">
<![CDATA[valve [:=] 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="200" Y="580" Operand="Step_002" HideDesc="false" DescX="240" DescY="560" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_002" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// count]]>
</Line>
<Line Number="1">
<![CDATA[JSR(count_cycles,0);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="6" X="200" Y="220" Operand="Tran_000" HideDesc="false" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="7" X="200" Y="460" Operand="Tran_001" HideDesc="false" DescX="260" DescY="440" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="8" X="200" Y="700" Operand="Tran_002" HideDesc="false" DescX="260" DescY="680" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[TRUE]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="6" Show="true"/>
<DirectedLink FromID="2" ToID="7" Show="true"/>
<DirectedLink FromID="4" ToID="8" Show="true"/>
<DirectedLink FromID="6" ToID="2" Show="true"/>
<DirectedLink FromID="7" ToID="4" Show="true"/>
<DirectedLink FromID="8" ToID="0" Show="true"/>
</SFCContent>
</Routine>
<Routine Name="mixer" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_003" HideDesc="false" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_003" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// stopped]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_004" HideDesc="false" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_004" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// mix]]>
</Line>
<Line Number="1">
<![CDATA[mixer_on [:=] 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="4" X="200" Y="220" Operand="Tran_003" HideDesc="false" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.X]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="5" X="200" Y="460" Operand="Tran_004" HideDesc="false" DescX="260" DescY="440" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[NOT Step_001.X]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="4" Show="true"/>
<DirectedLink FromID="2" ToID="5" Show="true"/>
<DirectedLink FromID="4" ToID="2" Show="true"/>
<DirectedLink FromID="5" ToID="0" Show="true"/>
</SFCContent>
</Routine>
<Routine Name="alarms" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[alarm := level_high AND NOT valve;]]>
</Line>
</STContent>
</Routine>
<Routine Name="count_cycles" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[cycles := cycles + 1;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>