<Action ID="7" Operand="Action_003" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// drill]]>
</Line>
<Line Number="1">
<![CDATA[drill_motor [:=] 1;]]>
</Line>
<Line Number="2">
<![CDATA[IF drill_depth > 50 THEN]]>
</Line>
<Line Number="3">
<![CDATA[  drill_alarm := 1;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="8" X="200" Y="1365" Operand="Step_004" HideDesc="true" DescX="240" DescY="1345" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_004" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// deburr]]>
</Line>
<Line Number="1">
<![CDATA[brush [:=] 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="10" X="200" Y="1605" Operand="Step_005" HideDesc="true" DescX="240" DescY="1585" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="11" Operand="Action_005" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// unload]]>
</Line>
<Line Number="1">
<![CDATA[eject [:=] 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
