<Routines>
<Routine Name="tp12_qualifiers" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="true" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// idle]]>
</Line>
<Line Number="1">
<![CDATA[ready := 0; done_lamp := 0; // sugar: latch both off]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_001" HideDesc="true" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_001" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// fill - Fill the tank]]>
</Line>
<Line Number="1">
<![CDATA[valve [:=] 1; pump [:=] 1; // N action (sugar): on while fill is active]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="4" Operand="Action_002" Qualifier="StoredUntilReset" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[alarm_lamp := 1;      // S action: stays on after fill, until reset]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="5" Operand="Action_003" Qualifier="TimeLimited" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[horn [:=] 1;          // L action: horn for 5 s at most]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="6" Operand="Action_004" Qualifier="TimeDelayed" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[mixer [:=] 1;         // D action: starts 2 s after fill becomes active]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="7" Operand="Action_005" Qualifier="Pulse" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[count := count + 1;   // P action: once, when fill becomes active]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="8" X="200" Y="740" Operand="Step_002" HideDesc="true" DescX="240" DescY="720" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_006" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// done]]>
</Line>
<Line Number="1">
<![CDATA[ready := 1; done_lamp := 1; // sugar: latch both on]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="10" Operand="Action_007" Qualifier="Reset" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[alarm_lamp := 0;      // R action: meant to reset the S action of fill]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="11" X="200" Y="220" Operand="Tran_000" HideDesc="true" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="12" X="200" Y="620" Operand="Tran_001" HideDesc="true" DescX="260" DescY="600" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN OR level_high]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="13" X="200" Y="882" Operand="Tran_002" HideDesc="true" DescX="260" DescY="862" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[ack_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="11" Show="true"/>
<DirectedLink FromID="2" ToID="12" Show="true"/>
<DirectedLink FromID="8" ToID="13" Show="true"/>
<DirectedLink FromID="11" ToID="2" Show="true"/>
<DirectedLink FromID="12" ToID="8" Show="true"/>
<DirectedLink FromID="13" ToID="0" Show="true"/>
</SFCContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>