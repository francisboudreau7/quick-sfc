</Body>
</Action>
</Step>
<Step ID="8" X="500" Y="902" Operand="Step_004" HideDesc="true" DescX="540" DescY="882" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_004" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// retry]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="10" X="200" Y="220" Operand="Tran_000" HideDesc="true" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="11" X="200" Y="460" Operand="Tran_001" HideDesc="true" DescX="260" DescY="440" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN OR (Step_001.T >= 3000 AND level_ok)]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="12" X="200" Y="782" Operand="Tran_002" HideDesc="true" DescX="260" DescY="762" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_002.T > 2000 AND level_ok]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="13" X="200" Y="1022" Operand="Tran_003" HideDesc="true" DescX="260" DescY="1002" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_003.T >= 2000]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="14" X="500" Y="782" Operand="Tran_004" HideDesc="true" DescX="560" DescY="762" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_002.T >= 5000 AND NOT level_ok]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="15" X="500" Y="1022" Operand="Tran_005" HideDesc="true" DescX="560" DescY="1002" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_004.X]]>
</Line>
</STContent>
</Condition>
</Transition>
