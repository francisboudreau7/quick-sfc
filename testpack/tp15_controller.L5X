<Routines>
<Routine Name="main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[JSR(cycle,0);]]>
</Line>
<Line Number="1">
<![CDATA[JSR(seq,0);]]>
</Line>
</STContent>
</Routine>
<Routine Name="cycle" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="true" DescX="240" DescY="80" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// idle]]>
</Line>
<Line Number="1">
<![CDATA[SFR(seq, Step_003);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="200" Y="340" Operand="Step_001" HideDesc="true" DescX="240" DescY="320" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_001" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// fill]]>
</Line>
<Line Number="1">
<![CDATA[lamp [:=] 1;]]>
</Line>
<Line Number="2">
<![CDATA[SFP(seq, Execute);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="200" Y="580" Operand="Step_002" HideDesc="true" DescX="240" DescY="560" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_002" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[// pause_seq]]>
</Line>
<Line Number="1">
<![CDATA[SFP(seq, Pause);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="6" X="200" Y="220" Operand="Tran_000" HideDesc="true" DescX="260" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[start_btn]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="7" X="200" Y="460" Operand="Tran_001" HideDesc="true" DescX="260" DescY="440" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Step_001.DN and fills >= cycles_max]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="8" X="200" Y="700" Operand="Tran_002" HideDesc="true" DescX="260" DescY="680" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[stop_req]]>
</Line>
</STContent>
</Condition>
</Transition>
<DirectedLink FromID="0" ToID="6" Show="true"/>
<DirectedLink FromID="2" ToID="7" Show="true"/>
<DirectedLink FromID="4" ToID="8" Show="true"/>
<DirectedLink FromID="6" ToID="2" Show="true"/>
<DirectedLink FromID="7" ToID="4" Show="true"/>
<DirectedLink FromID="8" ToID="0" Show="true"/>
</SFCContent>
</Routine>
